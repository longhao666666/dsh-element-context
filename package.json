{
  "name": "@local/dsh-element-context",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bridge the selected UI element into systemPrompt, with a composer dock chip",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/longhao666666/dsh-element-context.git"
  },
  "exports": {
    ".": "./host.js",
    "./client": "./client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
